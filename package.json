{
  "name": "minuit-au-village",
  "version": "0.1.0",
  "private": true,
  "description": "Minuit au village — environnement 3D du village médiéval (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n serveur,client -c magenta,cyan \"npm:server\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "shots": "node --import tsx scripts/screenshots.ts",
    "server": "tsx watch src/server/index.ts",
    "start": "NODE_ENV=production tsx src/server/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "three": "^0.170.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.52.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
