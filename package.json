{
  "name": "minuit-au-village",
  "version": "0.1.0",
  "private": true,
  "description": "Minuit au village — environnement 3D du village médiéval (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "shots": "node --import tsx scripts/screenshots.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/three": "^0.170.0",
    "playwright-core": "^1.52.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
